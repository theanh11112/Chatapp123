# .env - UPDATED VERSION

# ====================
# 🌐 API CONFIGURATION
# ====================
REACT_APP_BACKEND_URL=http://localhost:3001

# ====================
# 🎥 ZEGO VIDEO CALL CONFIGURATION
# ====================
REACT_APP_ZEGO_APP_ID=1642584767
REACT_APP_ZEGO_SERVER_SECRET=your_actual_zego_server_secret_here
REACT_APP_ZEGO_SERVER_URL=wss://webrtc.zego.im/ws
REACT_APP_ZEGO_TOKEN_ENDPOINT=/call/generate-zego-token

# ====================
# ☁️ AWS S3 CONFIGURATION
# ====================
REACT_APP_S3_BUCKET_NAME=codingmonk
REACT_APP_AWS_S3_REGION=ap-south-1

# ====================
# 🔐 KEYCLOAK/AUTH CONFIGURATION (nếu có)
# ====================
# REACT_APP_KEYCLOAK_URL=http://localhost:8080
# REACT_APP_KEYCLOAK_REALM=your-realm-name
# REACT_APP_KEYCLOAK_CLIENT_ID=your-client-id

# ====================
# 🔧 DEVELOPMENT CONFIGURATION
# ====================
EXTEND_ESLINT=true
DISABLE_ESLINT_PLUGIN=true
ESLINT_NO_DEV_ERRORS=true

# ====================
# 🎨 APP CONFIGURATION
# ====================
REACT_APP_NAME=Chat Application
REACT_APP_VERSION=1.0.0
REACT_APP_DEBUG=true